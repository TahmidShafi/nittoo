  "additionalProperties": false,
  "description": "Exact mirror of `generateJsonBackup` in `src/lib/export/json.ts`.",
  "properties": {
    "version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "title": "Version",
      "type": "string"
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "user": {
      "$ref": "#/$defs/ExportUser"
    },
    "summary": {
      "$ref": "#/$defs/ExportSummary"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/ExportProductItem"
      },
