          "type": "integer"
        },
        "estimatedMonthlyCost": {
          "minimum": 0,
          "title": "Estimatedmonthlycost",
          "type": "number"
        },
        "percentage": {
          "maximum": 100,
          "minimum": 0,
          "title": "Percentage",
          "type": "number"
        }
      },
      "required": [
        "category",
        "activeCount",
        "estimatedMonthlyCost",
        "percentage"
      ],
      "title": "ExportCategoryBreakdown",
      "type": "object"
    },
