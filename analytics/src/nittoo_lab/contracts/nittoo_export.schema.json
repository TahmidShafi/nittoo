{
  "$defs": {
    "ExportAnalyticsItem": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "product_name": {
          "title": "Product Name",
          "type": "string"
        },
        "brand": {
          "title": "Brand",
          "type": "string"
        },
        "category": {
          "enum": [
            "Skincare",
            "Haircare",
            "Body Care",
            "Oral Care",
            "Supplements",
            "Personal Hygiene",
            "Shaving & Grooming",
            "Household Cleaning",
            "Laundry",
            "Home Essentials",
            "Food & Beverage",
            "Fitness",
            "Pet Care",
            "Baby Care",
            "Other"
          ],
          "title": "Category",
          "type": "string"
        },
        "observed_average_lifespan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Average Lifespan"
        },
        "completed_cycles": {
          "minimum": 0,
          "title": "Completed Cycles",
          "type": "integer"
        },
        "observed_cost_per_day": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Cost Per Day"
        },
        "estimated_monthly_consumption": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Monthly Consumption"
        },
        "predicted_finish_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Finish Date"
        },
        "predicted_remaining_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Remaining Days"
        },
        "confidence_state": {
          "title": "Confidence State",
          "type": "string"
        },
        "confidence_label": {
          "title": "Confidence Label",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "product_name",
        "brand",
        "category",
        "completed_cycles",
        "confidence_state",
        "confidence_label"
      ],
      "title": "ExportAnalyticsItem",
      "type": "object"
    },
    "ExportCategoryBreakdown": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "activeCount": {
          "minimum": 0,
