    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.13",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
